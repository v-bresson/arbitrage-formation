# Sauvegardes complètes du code (zip), y compris includes/db-config.php :
# ne doivent jamais être accessibles directement en HTTP (voir audit de
# sécurité). Uniquement lues/écrites côté serveur par includes/maintenance.php.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
